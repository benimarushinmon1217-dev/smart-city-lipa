# Smart City Lipa - Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_NAME=Smart City Lipa
APP_VERSION=3.0.0

# ============================================
# BACKEND CONFIGURATION
# ============================================
# Server
PORT=5000
HOST=localhost

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_city_lipa
DB_USER=root
DB_PASSWORD=your_database_password

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# AI SERVICES
# ============================================
# Groq API (for AI chatbot and advisories)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# ============================================
# EXTERNAL APIS (Future Integration)
# ============================================
# PAGASA Weather API
PAGASA_API_KEY=your_pagasa_api_key
PAGASA_API_URL=https://api.pagasa.dost.gov.ph

# PHIVOLCS Seismic API
PHIVOLCS_API_KEY=your_phivolcs_api_key
PHIVOLCS_API_URL=https://api.phivolcs.dost.gov.ph

# ============================================
# FILE UPLOADS
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/combined.log
ERROR_LOG_FILE=./logs/error.log

# ============================================
# SOCKET.IO
# ============================================
SOCKET_CORS_ORIGIN=http://localhost:5173

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# API Configuration
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Map Configuration
VITE_MAP_CENTER_LAT=13.9414
VITE_MAP_CENTER_LNG=121.1628
VITE_MAP_ZOOM=13
VITE_MAP_MAX_ZOOM=18
VITE_MAP_MIN_ZOOM=10

# Feature Flags
VITE_ENABLE_AI_CHATBOT=true
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_OFFLINE_MODE=false

# App Configuration
VITE_APP_NAME=Smart City Lipa
VITE_APP_VERSION=3.0.0

# ============================================
# DEMO MODE (Optional)
# ============================================
DEMO_MODE=false
DEMO_ADMIN_EMAIL=admin@smartcitylipa.com
DEMO_ADMIN_PASSWORD=demo123456
DEMO_USER_EMAIL=user@smartcitylipa.com
DEMO_USER_PASSWORD=demo123456

# ============================================
# DEPLOYMENT (Production)
# ============================================
# Set these in production environment
# DATABASE_URL=mysql://user:password@host:port/database
# REDIS_URL=redis://host:port
# SESSION_SECRET=your_session_secret
# SENTRY_DSN=your_sentry_dsn
